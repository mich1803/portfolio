---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";
import FeaturedContent from "./FeaturedContent.astro";
import CitationCard from "./CitationCard.astro";
import { Image } from "astro:assets";
import { withBase } from "../../utils/paths";
import { getContentLanguage } from "../../utils/language";

const activeSocials = SOCIALS.filter((social) => social.isActive);

interface Props {
    compact?: boolean;
    showFeatured?: boolean;
    citation?: string;
    summaryTitle?: string;
    cvDetails?: {
        skills: Array<{ category: string; items: string }>;
        languages: Array<{ language: string; proficiency: string }>;
    };
    cvDetailsIt?: {
        skills: Array<{ category: string; items: string }>;
        languages: Array<{ language: string; proficiency: string }>;
    };
    headings?: Array<{
        depth: number;
        slug: string;
        text: string;
        language?: "en" | "it";
        isOriginal?: boolean;
    }>;
}

const {
    compact = false,
    showFeatured = false,
    citation,
    summaryTitle = "In this post",
    cvDetails,
    cvDetailsIt,
    headings = [],
} = Astro.props;

const bioCollection = await getCollection("bio");
const bioEntry = bioCollection.find((entry: any) => !entry.data.translation_of) || bioCollection[0];
const bioTranslation = bioCollection.find((entry: any) => entry.data.translation_of === bioEntry?.id);
const bio = bioEntry?.data;
const bioVariants = [bioEntry, bioTranslation].filter(Boolean) as any[];
const defaultBioLanguage = bioVariants.some((entry) => getContentLanguage(entry.data) === "en") ? "en" : getContentLanguage(bio);
const headingLanguages = [...new Set(headings.map((heading) => heading.language || "en"))];
const defaultHeadingLanguage = headingLanguages.includes("en") ? "en" : headingLanguages[0];
---

<aside
    class:list={[
        "sidebar max-lg:flex-row max-lg:flex-wrap max-lg:gap-3 max-md:gap-2",
        { "sidebar-has-featured-content": showFeatured },
    ]}
>
    <div
        class="flex flex-col items-center text-center max-lg:flex-row max-lg:items-center max-lg:gap-3 max-lg:text-left max-md:gap-2"
    >
        {
            bio?.avatar && (
                <Image
                    src={withBase(bio.avatar)}
                    alt={`Avatar of ${bio.name}`}
                    data-i18n-alt="profile.avatar"
                    width={160}
                    height={160}
                    densities={[1.5, 2]}
                    format="webp"
                    class="sidebar-avatar sidebar-avatar-light"
                    loading="eager"
                />
            )
        }

        {
            bio?.avatar && (
                <Image
                    src={withBase(bio.avatarDark || bio.avatar)}
                    alt={`Avatar of ${bio.name} for the dark theme`}
                    data-i18n-alt="profile.avatarDark"
                    width={160}
                    height={160}
                    densities={[1.5, 2]}
                    format="webp"
                    class="sidebar-avatar sidebar-avatar-dark"
                    loading="eager"
                />
            )
        }

        <div class="flex flex-col items-center max-lg:items-start">
            {bio?.name && <h1 class="sidebar-name">{bio.name}</h1>}

            {
                !compact && bioVariants.some((variant) => variant.data.institution || variant.data.location) && (
                    <div class="sidebar-info" data-language-variants data-has-it={String(Boolean(bioTranslation))}>
                        <Icon name="Institution" size={24} />
                        {bioVariants.map((variant) => (
                            <span
                                class="sidebar-affiliation-text"
                                data-language-variant={getContentLanguage(variant.data)}
                                data-language-original={String(variant.data.translation_status === "original")}
                                hidden={getContentLanguage(variant.data) !== defaultBioLanguage}
                            >
                            {variant.data.institution && <span>{variant.data.institution}</span>}
                            {variant.data.location && (
                                <span class="sidebar-location">
                                    {variant.data.location}
                                </span>
                            )}
                            </span>
                        ))}
                    </div>
                )
            }

            {
                !compact && bioVariants.some((variant) => variant.data.shortBio) && (
                    <div data-language-variants data-has-it={String(Boolean(bioTranslation))}>
                        {bioVariants.map((variant) => variant.data.shortBio && (
                            <p
                                class="sidebar-bio mt-2 max-md:hidden"
                                data-language-variant={getContentLanguage(variant.data)}
                                data-language-original={String(variant.data.translation_status === "original")}
                                hidden={getContentLanguage(variant.data) !== defaultBioLanguage}
                            >
                                {variant.data.shortBio}
                            </p>
                        ))}
                    </div>
                )
            }

            <div
                class="mt-3 flex flex-wrap items-center justify-center gap-1 max-lg:justify-start"
            >
                {
                    activeSocials.map((social) => {
                        const socialKey = social.name === "Github"
                            ? "social.github"
                            : social.name === "Mail"
                                ? "social.mail"
                                : social.name === "Google Scholar"
                                    ? "social.googleScholar"
                                    : social.name === "LinkedIn"
                                        ? "social.linkedin"
                                        : "social.orcid";
                        return (
                        <a
                            href={social.href}
                            aria-label={social.linkTitle}
                            title={social.linkTitle}
                            data-i18n-aria-label={socialKey}
                            data-i18n-title={socialKey}
                            target="_blank"
                            rel="noreferrer"
                            class="social-link"
                        >
                            <Icon
                                name={
                                    SOCIAL_ICONS[social.name] || social.name
                                }
                                size={24}
                            />
                        </a>
                        );
                    })
                }
            </div>
        </div>
    </div>

    {
        cvDetails && (
            <section class="cv-sidebar-details" aria-label="Skills and languages" data-i18n-aria-label="sidebar.skillsAndLanguages">
                <div data-language-variants data-has-it={String(Boolean(cvDetailsIt))}>
                {[{ language: "en", data: cvDetails }, ...(cvDetailsIt ? [{ language: "it", data: cvDetailsIt }] : [])].map((variant) => (
                <div data-language-variant={variant.language} data-language-original={String(variant.language === "en")} hidden={variant.language !== "en"}>
                {variant.data.skills.length > 0 && (
                    <div class="cv-sidebar-section">
                        <p class="cv-sidebar-title" data-i18n="sidebar.skills">Skills</p>
                        <dl class="cv-sidebar-list">
                            {variant.data.skills.map((skill) => (
                                <div>
                                    <dt>{skill.category}</dt>
                                    <dd>{skill.items}</dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                )}
                {variant.data.languages.length > 0 && (
                    <div class="cv-sidebar-section">
                        <p class="cv-sidebar-title" data-i18n="sidebar.languages">Languages</p>
                        <dl class="cv-sidebar-list">
                            {variant.data.languages.map((language) => (
                                <div>
                                    <dt>{language.language}</dt>
                                    <dd>{language.proficiency}</dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                )}
                </div>
                ))}
                </div>
            </section>
        )
    }

    {
        showFeatured && <FeaturedContent class="sidebar-featured-content" />
    }

    {citation && <CitationCard citation={citation} />}

    {
        compact && headings.length > 0 && (
            <nav class="post-toc" aria-label={summaryTitle} data-i18n-aria-label={summaryTitle === "In this project" ? "sidebar.inProject" : "sidebar.inPost"}>
                <p class="post-toc-title" data-i18n={summaryTitle === "In this project" ? "sidebar.inProject" : "sidebar.inPost"}>{summaryTitle}</p>
                <div data-language-variants data-has-it={String(headingLanguages.includes("it"))}>
                    {headingLanguages.map((language) => (
                        <ol
                            class="post-toc-list"
                            data-language-variant={language}
                            data-language-original={String(
                                headings.some((heading) =>
                                    (heading.language || "en") === language && heading.isOriginal,
                                ),
                            )}
                            hidden={language !== defaultHeadingLanguage}
                        >
                            {headings
                                .filter((heading) => (heading.language || "en") === language)
                                .map((heading) => (
                                    <li class:list={{ "post-toc-nested": heading.depth === 3 }}>
                                        <a
                                            href={`#${heading.slug}`}
                                            class="post-toc-link"
                                            data-post-toc-link
                                            data-heading-id={heading.slug}
                                        >
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                        </ol>
                    ))}
                </div>
            </nav>
        )
    }
</aside>

<script>
    let tocObserver: IntersectionObserver | undefined;

    function initPostTableOfContents() {
        tocObserver?.disconnect();

        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-post-toc-link]"),
        ).filter((link) => !link.closest("[data-language-variant][hidden]"));
        const sections = links
            .map((link) => {
                const id = link.dataset.headingId;
                return id ? document.getElementById(id) : null;
            })
            .filter((section): section is HTMLElement => section !== null);

        if (links.length === 0 || sections.length === 0) return;

        const setActiveLink = (id: string) => {
            links.forEach((link) => {
                const isActive = link.dataset.headingId === id;
                link.classList.toggle("is-active", isActive);
                if (isActive) link.setAttribute("aria-current", "location");
                else link.removeAttribute("aria-current");
            });
        };

        const updateActiveLink = () => {
            const activeSection = [...sections]
                .reverse()
                .find((section) => section.getBoundingClientRect().top <= 180);
            setActiveLink((activeSection ?? sections[0]).id);
        };

        tocObserver = new IntersectionObserver(updateActiveLink, {
            rootMargin: "-120px 0px -65% 0px",
            threshold: [0, 1],
        });
        sections.forEach((section) => tocObserver?.observe(section));
        updateActiveLink();
    }

    document.addEventListener("astro:page-load", initPostTableOfContents);
    document.addEventListener("content-language-change", initPostTableOfContents);
</script>
