---
import { SITE, THEME_CONFIG } from "../../config";
import Icon from "../ui/Icon.astro";
import { withBase } from "../../utils/paths";

const currentYear = new Date().getFullYear();
const showToggle = THEME_CONFIG.lightAndDark;
---

<footer class="footer">
    <div class="flex items-center gap-4">
        <span class="body-xs">&copy; {currentYear} {SITE.author}.</span>
    </div>
    <div class="flex items-center gap-4">
        <a
            href={withBase("/rss.xml")}
            aria-label="RSS Feed"
            title="RSS Feed"
            data-i18n-aria-label="footer.rss"
            data-i18n-title="footer.rss"
            target="_blank"
            rel="noreferrer"
            class="btn-icon"
        >
            <Icon name="RSS" size={16} />
        </a>
        {
            showToggle && (
                <button
                    id="theme-toggle"
                    aria-label="Toggle Dark Mode"
                    title="Toggle Dark Mode"
                    data-i18n-aria-label="footer.theme"
                    data-i18n-title="footer.theme"
                    class="btn-icon"
                >
                    <Icon name="Sun" size={16} class="hidden dark:block" />
                    <Icon name="Moon" size={16} class="block dark:hidden" />
                </button>
            )
        }
    </div>
</footer>
