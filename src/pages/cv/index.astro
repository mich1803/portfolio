---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES } from "../../config";
import CvContent from "../../components/cv/CvContent.astro";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
    throw new Error(
        "CV content not found. Please ensure src/content/cv.md exists.",
    );
}

const { Content } = await render(cvEntry);
const cvItEntry = await getEntry("cv", "cv-it");
const { Content: ContentIt } = cvItEntry ? await render(cvItEntry) : { Content: null };
const {
    experience = [],
    education = [],
    skills = [],
    languages = [],
    hobbies,
} = cvEntry.data;
const cvItData = cvItEntry?.data;
---

<BaseLayout
    title={PAGES.cv.title}
    titleIt="Curriculum Vitae"
    description={PAGES.cv.subtitle}
    descriptionIt="Percorso accademico e professionale."
    sidebarVariant="cv"
    sidebarCvDetails={{ skills, languages }}
    sidebarCvDetailsIt={cvItData ? { skills: cvItData.skills || [], languages: cvItData.languages || [] } : undefined}
>
    <header class="page-header">
        <h1 class="page-title" data-i18n="page.cv.title">{PAGES.cv.title}</h1>
        <p class="page-subtitle" data-i18n="page.cv.subtitle">{PAGES.cv.subtitle}</p>
    </header>

    <div class="container-narrow">
        <div data-language-variants data-has-it={String(Boolean(cvItData && ContentIt))}>
            <div data-language-variant="en" data-language-original="true">
                <CvContent data={cvEntry.data} Content={Content} />
            </div>
            {cvItData && ContentIt && (
                <div lang="it" data-language-variant="it" data-language-original="false" hidden>
                    <CvContent data={cvItData} Content={ContentIt} />
                </div>
            )}
        </div>
    </div>
</BaseLayout>

