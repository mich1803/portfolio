---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BaseItemCard from "../components/ui/BaseItemCard.astro";
import { getListingItem } from "../utils/adapters";
import { getPublicationType, isPublicationVisible } from "../utils/publications";
import { withBase } from "../utils/paths";
import { getContentLanguage } from "../utils/language";
import { UI_TRANSLATIONS } from "../config/i18n";

interface Props {
    collection: "publications" | "projects" | "posts";
    title: string;
    subtitle?: string;
}

const { collection, title, subtitle } = Astro.props;

const allEntries = await getCollection(collection);
let entries = allEntries.filter((entry: any) => !entry.data.translation_of);
if (collection === "publications") entries = entries.filter(isPublicationVisible);

const translationsByOriginal = new Map<string, any[]>();
allEntries.forEach((entry: any) => {
    if (!entry.data.translation_of) return;
    const translations = translationsByOriginal.get(entry.data.translation_of) || [];
    translations.push(entry);
    translationsByOriginal.set(entry.data.translation_of, translations);
});

const pageKey = collection === "posts" ? "blog" : collection;
const titleKey = `page.${pageKey}.title` as keyof typeof UI_TRANSLATIONS;
const subtitleKey = `page.${pageKey}.subtitle` as keyof typeof UI_TRANSLATIONS;
const titleIt = UI_TRANSLATIONS[titleKey]?.it || title;
const subtitleIt = UI_TRANSLATIONS[subtitleKey]?.it || subtitle;

const sortedEntries = entries.sort((a: any, b: any) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
});
---

<BaseLayout title={title} titleIt={titleIt} description={subtitle} descriptionIt={subtitleIt} sidebarVariant="listing">
    {(title || subtitle) && (
        <header class="page-header">
            {title && <h1 class="page-title" data-i18n={titleKey}>{title}</h1>}
            {subtitle && <p class="page-subtitle" data-i18n={subtitleKey}>{subtitle}</p>}
        </header>
    )}

    <slot name="before-list" />

    <section class="item-list">
        {sortedEntries.map((entry: any) => {
            const item = getListingItem(entry, collection);
            const titleUrl = collection === "projects" ? entry.data.title_url : undefined;
            const variants = [entry, ...(translationsByOriginal.get(entry.id) || [])]
                .sort((a: any, b: any) => getContentLanguage(a.data) === "en" ? -1 : 1)
                .map((variant: any) => ({
                    language: getContentLanguage(variant.data),
                    isOriginal: variant.data.translation_status === "original",
                    title: variant.data.title,
                    description: variant.data.description,
                    authors: variant.data.author,
                    tags: [
                        ...(collection === "publications" && getPublicationType(variant)
                            ? [getPublicationType(variant) as string]
                            : []),
                        ...(variant.data.tags || []),
                    ],
                    extraInput: variant.data.journal || variant.data.event || variant.data.institution,
                }));

            return (
                <BaseItemCard
                    {...item}
                    href={titleUrl || withBase(`/${collection}/${entry.id}`)}
                    titleExternal={Boolean(titleUrl)}
                    contentVariants={variants}
                />
            );
        })}
    </section>

</BaseLayout>
